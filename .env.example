# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of this app (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (Resend). Leave blank in dev: emails are printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM="OnTour Upgrades <upgrades@ontour.vip>"

# Where "new artist submitted for review" alerts go
ADMIN_NOTIFY_EMAIL=eddie@please.co

# Supabase service role key (Project Settings > API > service_role). Server-only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# P&T's Stripe platform account (Developers > API keys). Use sk_test_ first, then sk_live_ at launch.
STRIPE_SECRET_KEY=
# Webhook signing secrets (Developers > Webhooks), both pointing at /api/stripe/webhook:
# snapshot events (checkout.session.completed) and thin Accounts v2 events (v2.core.account...).
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_EVENTS_WEBHOOK_SECRET=
